{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mkv-cloudflare-player",
  "main": "src/index.js",
  "compatibility_date": "2026-09-15",
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/proxy",
      "/api/*"
    ]
  }
}
